# Copy this file to terraform.tfvars and fill in your values.
#
# stackit_region has a default of "eu01" and can be omitted.

stackit_org_id                   = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
stackit_service_account_key_path = "/path/to/stackit-sa.json"
stackit_admin_email              = "admin@example.com"

stackit_project_name_sna_01      = "vpn-sna-01"
stackit_sna_name_sna_01          = "vpn-sna-01"

stackit_project_name_sna_02      = "vpn-sna-02"
stackit_sna_name_sna_02          = "vpn-sna-02"
