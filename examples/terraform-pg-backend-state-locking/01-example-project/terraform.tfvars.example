# ---------------------------------------------------------------------------
# terraform.tfvars.example
#
# Copy this file to terraform.tfvars in this directory (01-example-project/)
# and fill in your values. Do NOT commit terraform.tfvars to version control.
#
# Alternatively, export variables as environment variables:
#   export TF_VAR_stackit_parent_container_id="<uuid>"
# ---------------------------------------------------------------------------

# --- STACKIT Identity --------------------------------------------------------

# Organization or folder the project is created in.
stackit_parent_container_id = "<your-organization-or-folder-id>"

# Display name of the project. Optional: defaults to "01-example-project".
# stackit_project_name = "01-example-project"

# Email address of the STACKIT user set as project owner.
stackit_admin_email = "<your-admin@mail.com>"

# --- Service Account ---------------------------------------------------------

# Path to the STACKIT service account key file. Optional: unset falls back to
# STACKIT_SERVICE_ACCOUNT_KEY_PATH, then to the credentials file.
# Download: STACKIT portal > Service Accounts > Keys > Create key
# stackit_service_account_key_path = "./keys/service-account.json"

# --- Region ------------------------------------------------------------------

# STACKIT region. Optional: defaults to "eu01".
# stackit_region = "eu01"
