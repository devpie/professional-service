stackit_project_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Unset, the provider reads STACKIT_SERVICE_ACCOUNT_KEY_PATH or its credentials file.
# stackit_service_account_key_path = "/path/to/sa-key.json"

# Receives the alert notifications.
alert_email = "admin@example.com"

# Unset, the cluster is created with the latest Kubernetes version that SKE
# supports. Uncomment to pin a minimum version instead.
# kubernetes_version_min = "1.36"
