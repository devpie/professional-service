# Copy this file to terraform.tfvars and fill in your own values.
# Required: stackit_project_id, acl, stackit_service_account_key_path

stackit_project_id               = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
stackit_region                   = "eu01"
stackit_service_account_key_path = "./keys/stackit-sa.json"

instance_name = "pg-kms-example"

# Only these networks may reach the instance. Use your own egress ranges.
acl = ["203.0.113.10/32"]

flavor_id        = "2.4"
storage_class    = "premium-perf2-stackit"
storage_size     = 10
postgres_version = "17"

# Cron expression in UTC, one run per day.
backup_schedule = "0 2 * * *"

# Backups are kept between 32 and 90 days.
retention_days = 32

# Fixed for the lifetime of the instance. Changing it replaces the instance.
kek_key_version = "1"
