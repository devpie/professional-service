# Copy this file to terraform.tfvars and fill in your values.
#
# stackit_region defaults to "eu01".
# stackit_parent_container_id must be the organization: SKE rejects a cluster in
# a folder-nested project.
# stackit_service_account_key_path is optional; unset lets the provider resolve
# credentials via STACKIT_SERVICE_ACCOUNT_KEY_PATH or $HOME/.stackit/credentials.json.

stackit_org_id              = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
stackit_parent_container_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
stackit_admin_email         = "admin@example.com"
